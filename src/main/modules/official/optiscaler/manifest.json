{
    "id": "optiscaler",
    "name": "OptiScaler",
    "description": "DLSS girdilerini FSR ve XeSS upscalerlarına dönüştürerek desteklenmeyen GPU'larda upscaling sağlar.",
    "author": "cdozdil",
    "version": "latest",
    "source": {
        "type": "github",
        "repo": "optiscaler/OptiScaler",
        "release": "latest",
        "asset": [
            "*.7z",
            "*.zip"
        ],
        "maxReleases": 10,
        "legacyFolders": [
            "OptiScaler"
        ]
    },
    "install": {
        "destination": "game_exe",
        "extractRoot": "auto",
        "cleanStaleVersionFiles": true,
        "refreshGameOnComplete": true,
        "proxyDetection": {
            "sourceFile": "OptiScaler.dll",
            "candidates": [
                "dxgi.dll",
                "winmm.dll",
                "d3d12.dll",
                "dbghelp.dll",
                "version.dll",
                "wininet.dll",
                "winhttp.dll"
            ],
            "descriptionMatch": "optiscaler",
            "defaultTarget": "dxgi.dll"
        },
        "verifyAntiVirusDelayMs": 1500
    },
    "config": [
        {
            "file": "OptiScaler.ini",
            "format": "ini",
            "search": [
                "OptiScaler.ini",
                "optiscaler.ini"
            ],
            "required": false,
            "createIfMissing": false,
            "schema": {
                "Plugins": {
                    "LoadAsiPlugins": {
                        "label": "ASI Eklentiler (LoadAsiPlugins)",
                        "labelKey": "modSettings.labels.loadAsiPlugins",
                        "type": "dropdown",
                        "options": [
                            {
                                "val": "auto",
                                "label": "Kapalı (Varsayılan)",
                                "labelKey": "modSettings.options.disabledDefault"
                            },
                            {
                                "val": "true",
                                "label": "Açık",
                                "labelKey": "modSettings.options.enabled"
                            }
                        ]
                    }
                },
                "Menu": {
                    "ShowFps": {
                        "label": "FPS Göster (ShowFps)",
                        "labelKey": "modSettings.labels.showFps",
                        "type": "dropdown",
                        "options": [
                            {
                                "val": "auto",
                                "label": "Kapalı (Varsayılan)",
                                "labelKey": "modSettings.options.disabledDefault"
                            },
                            {
                                "val": "true",
                                "label": "Açık",
                                "labelKey": "modSettings.options.enabled"
                            }
                        ]
                    },
                    "FpsOverlayPos": {
                        "label": "FPS Pozisyonu (FpsOverlayPos)",
                        "labelKey": "modSettings.labels.fpsOverlayPos",
                        "type": "dropdown",
                        "options": [
                            {
                                "val": "auto",
                                "label": "Varsayılan",
                                "labelKey": "modSettings.options.default"
                            },
                            {
                                "val": "0",
                                "label": "Sol Üst",
                                "labelKey": "modSettings.options.topLeft"
                            },
                            {
                                "val": "1",
                                "label": "Sağ Üst",
                                "labelKey": "modSettings.options.topRight"
                            },
                            {
                                "val": "2",
                                "label": "Sol Alt",
                                "labelKey": "modSettings.options.bottomLeft"
                            },
                            {
                                "val": "3",
                                "label": "Sağ Alt",
                                "labelKey": "modSettings.options.bottomRight"
                            }
                        ]
                    },
                    "FpsOverlayType": {
                        "label": "FPS Tipi (FpsOverlayType)",
                        "labelKey": "modSettings.labels.fpsOverlayType",
                        "type": "dropdown",
                        "options": [
                            {
                                "val": "auto",
                                "label": "Varsayılan",
                                "labelKey": "modSettings.options.default"
                            },
                            {
                                "val": "0",
                                "label": "Sadece FPS",
                                "labelKey": "modSettings.options.fpsOnly"
                            },
                            {
                                "val": "1",
                                "label": "Basitleştirilmiş",
                                "labelKey": "modSettings.options.simplified"
                            },
                            {
                                "val": "2",
                                "label": "Detaylı",
                                "labelKey": "modSettings.options.detailed"
                            },
                            {
                                "val": "3",
                                "label": "Detaylı + Grafikli",
                                "labelKey": "modSettings.options.detailedGraph"
                            },
                            {
                                "val": "4",
                                "label": "Full",
                                "labelKey": "modSettings.options.full"
                            },
                            {
                                "val": "5",
                                "label": "Full + Grafikli",
                                "labelKey": "modSettings.options.fullGraph"
                            },
                            {
                                "val": "6",
                                "label": "Reflex Zamanlamaları",
                                "labelKey": "modSettings.options.reflexTimings"
                            }
                        ]
                    }
                },
                "FrameGen": {
                    "visibleIf": {
                        "flag": "hasDlssEnabler",
                        "value": false
                    },
                    "Enabled": {
                        "label": "Etkinleştirildi (Enabled)",
                        "labelKey": "modSettings.labels.enabled",
                        "type": "dropdown",
                        "options": [
                            {
                                "val": "true",
                                "label": "Açık (True)",
                                "labelKey": "modSettings.options.true"
                            },
                            {
                                "val": "false",
                                "label": "Kapalı (False)",
                                "labelKey": "modSettings.options.false"
                            }
                        ],
                        "displayDefault": "false"
                    },
                    "FGInput": {
                        "label": "FG Girdisi (FGInput)",
                        "labelKey": "modSettings.labels.fgInput",
                        "type": "dropdown",
                        "options": [
                            {
                                "val": "nofg",
                                "label": "nofg"
                            },
                            {
                                "val": "dlssg",
                                "label": "dlssg"
                            },
                            {
                                "val": "nukems",
                                "label": "nukems"
                            },
                            {
                                "val": "fsrfg",
                                "label": "fsrfg"
                            },
                            {
                                "val": "upscaler",
                                "label": "upscaler"
                            },
                            {
                                "val": "fsrfg30",
                                "label": "fsrfg30"
                            }
                        ],
                        "displayDefault": "nofg"
                    },
                    "FGOutput": {
                        "label": "FG Çıktısı (FGOutput)",
                        "labelKey": "modSettings.labels.fgOutput",
                        "type": "dropdown",
                        "options": [
                            {
                                "val": "nofg",
                                "label": "nofg"
                            },
                            {
                                "val": "fsrfg",
                                "label": "fsrfg"
                            },
                            {
                                "val": "xefg",
                                "label": "xefg"
                            },
                            {
                                "val": "nukems",
                                "label": "nukems"
                            }
                        ],
                        "displayDefault": "nofg"
                    }
                },
                "OptiFG": {
                    "visibleIf": {
                        "flag": "hasDlssEnabler",
                        "value": false
                    },
                    "HUDFix": {
                        "label": "Arayüz Düzeltmesi (HUDFix)",
                        "labelKey": "modSettings.labels.hudFix",
                        "type": "dropdown",
                        "options": [
                            {
                                "val": "true",
                                "label": "Açık (True)",
                                "labelKey": "modSettings.options.true"
                            },
                            {
                                "val": "false",
                                "label": "Kapalı (False)",
                                "labelKey": "modSettings.options.false"
                            }
                        ],
                        "displayDefault": "false"
                    }
                }
            },
            "presets": {
                "dev-opti-fg": {
                    "nameKey": "modSettings.presets.devOptiFgName",
                    "locked": true,
                    "values": {
                        "FrameGen.Enabled": "true",
                        "FrameGen.FGInput": "upscaler",
                        "FrameGen.FGOutput": "xefg",
                        "OptiFG.HUDFix": "true",
                        "Menu.ShowFps": "true"
                    }
                }
            }
        }
    ],
    "detect": {
        "priority": 40,
        "exclusiveGroup": "optiscaler-family",
        "depthStrategy": "shallowest",
        "match": {
            "proxyDll": {
                "candidates": [
                    "dxgi.dll",
                    "winmm.dll",
                    "d3d12.dll",
                    "dbghelp.dll",
                    "version.dll",
                    "wininet.dll",
                    "winhttp.dll",
                    "optiscaler.dll"
                ],
                "descriptionMatch": "optiscaler"
            },
            "versionRange": {
                "max": "0.10",
                "allowUnknown": true
            }
        }
    },
    "state": {
        "flag": "hasOptiscaler",
        "versionField": "optiscalerVersion",
        "pathField": "optiscalerPath",
        "injectionField": "optiscalerInjection",
        "upscalerField": "optiscaler"
    },
    "addons": [
        {
            "moduleId": "optipatcher",
            "label": "OptiPatcher",
            "labelKey": "opti.patcherLabel",
            "description": "OptiScaler icin ek ASI eklentilerini yukler ve ini dosyasini yapilandirir.",
            "default": false,
            "install": {
                "destination": "plugins",
                "files": {
                    "include": [
                        "*.asi"
                    ]
                },
                "renameTo": "OptiPatcher.asi"
            },
            "configChanges": {
                "Plugins.LoadAsiPlugins": "true"
            },
            "descriptionKey": "opti.patcherHelp"
        },
        {
            "moduleId": "fsr4",
            "label": "FSR4 INT8",
            "labelKey": "opti.fsr4Label",
            "description": "FSR4 upscaling dosyalarini yukleyerek oyunda FSR 4 destegi saglar.",
            "default": false,
            "install": {
                "destination": "game_exe",
                "files": {
                    "include": [
                        "*.dll"
                    ]
                }
            },
            "descriptionKey": "opti.fsr4Help"
        }
    ],
    "uninstall": {
        "files": [
            "OptiScaler.ini",
            "OptiScaler.log",
            "OptiMX.log",
            "nvapi.dll",
            "nvapi64.dll",
            "setup_linux.sh",
            "setup_windows.bat",
            "fakenvapi.dll",
            "fakenvapi.ini",
            "dlssg_to_fsr3_amd_is_better.dll",
            "!! README_EXTRACT ALL FILES TO GAME FOLDER !!.txt",
            "D3D12_Optiscaler",
            "OptiPatcher.asi"
        ],
        "verifiedDlls": [
            {
                "candidates": [
                    "dxgi.dll",
                    "winmm.dll",
                    "d3d12.dll",
                    "dbghelp.dll",
                    "version.dll",
                    "wininet.dll",
                    "winhttp.dll"
                ],
                "descriptionMatch": "optiscaler"
            }
        ],
        "restoreBackup": false,
        "resetState": true
    },
    "permissions": [
        "internet",
        "game_files"
    ],
    "metadata": {
        "homepage": "https://github.com/optiscaler/OptiScaler",
        "tags": [
            "optiscaler",
            "upscaler",
            "fsr",
            "xess",
            "frame-generation"
        ]
    }
}
