{
    "id": "dlssenabler",
    "name": "DLSS Enabler",
    "description": "NVIDIA DLSS Frame Generation özelliğini desteklenmeyen GPU'larda ve oyunlarda etkinleştirir.",
    "author": "artur-graniszewski",
    "version": "latest",
    "source": {
        "type": "github",
        "repo": "vuenxx/extra_goldteam34",
        "release": "latest",
        "asset": "*.zip",
        "maxReleases": 10,
        "legacyFolders": [
            "dlss-enabler"
        ]
    },
    "install": {
        "destination": "game_exe",
        "extractRoot": "auto",
        "proxyDetection": {
            "sourceFile": "version.dll",
            "candidates": [
                "version.dll",
                "dxgi.dll",
                "winmm.dll",
                "dbghelp.dll",
                "psapi.dll",
                "winhttp.dll"
            ],
            "descriptionMatch": "dlss enabler",
            "defaultTarget": "dxgi.dll"
        },
        "verifyAntiVirusDelayMs": 1500,
        "cleanStaleVersionFiles": true,
        "refreshGameOnComplete": true
    },
    "config": [
        {
            "file": "dlss-enabler.ini",
            "format": "ini",
            "search": [
                "dlss-enabler.ini",
                "dlssenabler.ini"
            ],
            "required": false,
            "createIfMissing": false,
            "set": {},
            "schema": {
                "NGX": {
                    "ScreenSpaceRayTracing": {
                        "type": "toggle",
                        "label": "Screen Space Ray Tracing"
                    },
                    "GlobalIllumination": {
                        "type": "toggle",
                        "label": "Global Illumination"
                    },
                    "AmbientOcclusion": {
                        "type": "toggle",
                        "label": "Ambient Occlusion"
                    },
                    "RayTracingQuality": {
                        "type": "slider",
                        "label": "RT Quality",
                        "min": 0,
                        "max": 3,
                        "step": 1
                    },
                    "RayTracingRange": {
                        "type": "slider",
                        "label": "RT Range",
                        "min": 0,
                        "max": 100,
                        "step": 1
                    },
                    "IlluminationStrength": {
                        "type": "slider",
                        "label": "Illumination Strength",
                        "min": 0,
                        "max": 100,
                        "step": 1
                    },
                    "OcclusionStrength": {
                        "type": "slider",
                        "label": "Occlusion Strength",
                        "min": 0,
                        "max": 100,
                        "step": 1
                    },
                    "HudDetectionMode": {
                        "type": "dropdown",
                        "label": "HUD Detection Mode",
                        "options": [
                            {
                                "val": 0,
                                "label": "Kapalı (0)",
                                "labelKey": "modSettings.options.disabled0"
                            },
                            {
                                "val": 1,
                                "label": "Mod 1",
                                "labelKey": "modSettings.options.mode1"
                            },
                            {
                                "val": 2,
                                "label": "Mod 2",
                                "labelKey": "modSettings.options.mode2"
                            }
                        ]
                    }
                },
                "Reflex": {
                    "VsyncOverride": {
                        "type": "toggle",
                        "label": "Vsync Override"
                    },
                    "Vsync": {
                        "type": "toggle",
                        "label": "Vsync"
                    },
                    "FpsLimit": {
                        "type": "toggle",
                        "label": "FPS Limiti"
                    },
                    "BoostOverride": {
                        "type": "toggle",
                        "label": "Boost Override"
                    },
                    "Boost": {
                        "type": "toggle",
                        "label": "Boost"
                    },
                    "DesiredFpsLimit": {
                        "type": "slider",
                        "label": "Hedef FPS Limiti",
                        "min": 30,
                        "max": 240,
                        "step": 1
                    }
                },
                "UI": {
                    "Monitoring": {
                        "type": "toggle",
                        "label": "Monitoring"
                    },
                    "SideBar": {
                        "type": "toggle",
                        "label": "SideBar"
                    },
                    "ToggleKey": {
                        "type": "text",
                        "label": "Aç/Kapat Tuşu (Toggle Key)"
                    },
                    "ScaleOverride": {
                        "type": "slider",
                        "label": "Scale Override",
                        "min": 0,
                        "max": 5,
                        "step": 1
                    }
                },
                "DeepDVC": {
                    "Intensity": {
                        "type": "slider",
                        "label": "Intensity",
                        "min": 0,
                        "max": 1,
                        "step": 0.1
                    },
                    "SaturationBoost": {
                        "type": "slider",
                        "label": "Saturation Boost",
                        "min": 0,
                        "max": 1,
                        "step": 0.1
                    }
                },
                "Performance": {
                    "OverdriveMode": {
                        "type": "dropdown",
                        "label": "Overdrive Mode",
                        "options": [
                            {
                                "val": 0,
                                "label": "Kapalı",
                                "labelKey": "modSettings.options.disabled"
                            },
                            {
                                "val": 1,
                                "label": "Açık",
                                "labelKey": "modSettings.options.enabled"
                            }
                        ]
                    },
                    "HudInterpolation": {
                        "type": "toggle",
                        "label": "HUD Interpolation"
                    },
                    "MFGOverrideMode": {
                        "type": "dropdown",
                        "label": "MFG Override Mode",
                        "options": [
                            {
                                "val": 0,
                                "label": "Kapalı (0)",
                                "labelKey": "modSettings.options.mfg0"
                            },
                            {
                                "val": 1,
                                "label": "1X MFG (1)",
                                "labelKey": "modSettings.options.mfg1"
                            },
                            {
                                "val": 2,
                                "label": "2X MFG (2)",
                                "labelKey": "modSettings.options.mfg2"
                            },
                            {
                                "val": 3,
                                "label": "3X MFG (3)",
                                "labelKey": "modSettings.options.mfg3"
                            },
                            {
                                "val": 4,
                                "label": "4X MFG (4)",
                                "labelKey": "modSettings.options.mfg4"
                            },
                            {
                                "val": 5,
                                "label": "5X MFG (5)",
                                "labelKey": "modSettings.options.mfg5"
                            },
                            {
                                "val": 6,
                                "label": "6X MFG (6)",
                                "labelKey": "modSettings.options.mfg6"
                            }
                        ]
                    },
                    "MFGHotkeys": {
                        "type": "toggle",
                        "label": "MFG Hotkeys"
                    },
                    "DynamicMFG": {
                        "type": "toggle",
                        "label": "Dynamic MFG"
                    },
                    "DynamicMFGThreshold2": {
                        "type": "slider",
                        "label": "Threshold 2",
                        "min": 0,
                        "max": 144,
                        "step": 1
                    },
                    "DynamicMFGThreshold3": {
                        "type": "slider",
                        "label": "Threshold 3",
                        "min": 0,
                        "max": 144,
                        "step": 1
                    },
                    "DynamicMFGThreshold4": {
                        "type": "slider",
                        "label": "Threshold 4",
                        "min": 0,
                        "max": 144,
                        "step": 1
                    },
                    "DynamicMFGThreshold5": {
                        "type": "slider",
                        "label": "Threshold 5",
                        "min": 0,
                        "max": 144,
                        "step": 1
                    },
                    "DFGMode": {
                        "type": "dropdown",
                        "label": "DFG Mode",
                        "options": [
                            {
                                "val": 0,
                                "label": "Kapalı",
                                "labelKey": "modSettings.options.disabled"
                            },
                            {
                                "val": 1,
                                "label": "Açık",
                                "labelKey": "modSettings.options.enabled"
                            }
                        ]
                    },
                    "DFGTargetFps": {
                        "type": "slider",
                        "label": "DFG Target FPS",
                        "min": 30,
                        "max": 240,
                        "step": 1
                    },
                    "DFGInstinct": {
                        "type": "toggle",
                        "label": "DFG Instinct"
                    },
                    "DFGMinFps": {
                        "type": "slider",
                        "label": "DFG Min FPS",
                        "min": 0,
                        "max": 144,
                        "step": 1
                    },
                    "ForceLoadDLSSG": {
                        "type": "toggle",
                        "label": "Force Load DLSSG"
                    }
                },
                "Debug": {
                    "Flags": {
                        "type": "text",
                        "label": "Flags"
                    },
                    "EarlyInit": {
                        "type": "toggle",
                        "label": "Early Init"
                    },
                    "UseFsrOnly": {
                        "type": "toggle",
                        "label": "Use FSR Only"
                    },
                    "HybridMfgForced": {
                        "type": "toggle",
                        "label": "Hybrid MFG Forced"
                    },
                    "DisableUI": {
                        "type": "toggle",
                        "label": "Disable UI"
                    }
                },
                "GhostBuster": {
                    "Enabled": {
                        "type": "toggle",
                        "label": "Enabled"
                    },
                    "DebugMode": {
                        "type": "dropdown",
                        "label": "Debug Mode",
                        "options": [
                            {
                                "val": 0,
                                "label": "Kapalı",
                                "labelKey": "modSettings.options.disabled"
                            },
                            {
                                "val": 1,
                                "label": "Açık",
                                "labelKey": "modSettings.options.enabled"
                            }
                        ]
                    }
                }
            },
            "presets": {
                "dev-best": {
                    "nameKey": "modSettings.presets.devBestName",
                    "locked": true,
                    "values": {
                        "Performance.MFGOverrideMode": 6,
                        "Performance.MFGHotkeys": true,
                        "UI.Monitoring": true,
                        "GhostBuster.Enabled": true
                    }
                }
            }
        }
    ],
    "conditions": [
        {
            "type": "check_conflicts",
            "enabled": false,
            "candidates": [
                "dxgi.dll",
                "winmm.dll",
                "d3d12.dll",
                "dbghelp.dll",
                "version.dll",
                "wininet.dll",
                "winhttp.dll",
                "psapi.dll"
            ],
            "ignoreDescriptionMatches": [
                "dlss enabler"
            ],
            "message": "Çakışan bir mod tespit edildi. Lütfen mevcut modu kaldırıp tekrar deneyin."
        }
    ],
    "backup": {
        "enabled": true,
        "files": [
            "dxgi.dll",
            "version.dll",
            "dlss-enabler.ini"
        ]
    },
    "detect": {
        "priority": 40,
        "depthStrategy": "shallowest",
        "match": {
            "anyFileName": [
                "dlss-enabler.dll"
            ],
            "proxyDll": {
                "candidates": [
                    "version.dll",
                    "dxgi.dll",
                    "winmm.dll",
                    "dbghelp.dll",
                    "psapi.dll",
                    "winhttp.dll"
                ],
                "descriptionMatch": "dlss enabler"
            }
        }
    },
    "state": {
        "flag": "hasDlssEnabler",
        "versionField": "dlssEnablerVersion",
        "pathField": "dlssEnablerPath",
        "upscalerField": "dlssEnabler"
    },
    "uninstall": {
        "files": [
            "dlss-enabler.ini",
            "dlss-enabler.log",
            "dlssg_to_fsr3_amd_is_better.dll",
            {
                "file": "OptiScaler.ini",
                "unlessState": {
                    "flag": "hasOptiscaler",
                    "value": true
                }
            }
        ],
        "verifiedDlls": [
            {
                "candidates": [
                    "dxgi.dll",
                    "winmm.dll",
                    "d3d12.dll",
                    "dbghelp.dll",
                    "version.dll",
                    "wininet.dll",
                    "winhttp.dll",
                    "psapi.dll"
                ],
                "descriptionMatch": "dlss enabler"
            }
        ],
        "restoreBackup": false,
        "resetState": true
    },
    "permissions": [
        "internet",
        "game_files"
    ],
    "wizard": {
        "type": "auto_test",
        "title": "DLSS Enabler Otomatik Kurulum Sihirbazı",
        "description": "Oyun için en uygun DLL injection yöntemini otomatik olarak test eder.",
        "autoTest": {
            "sourceFile": "version.dll",
            "candidates": [
                "version.dll",
                "dxgi.dll",
                "winmm.dll",
                "dbghelp.dll",
                "psapi.dll",
                "winhttp.dll"
            ],
            "watchFile": "dlss-enabler.ini",
            "watchLocation": "game_exe",
            "timeoutSeconds": 10,
            "checkProcessRunning": true,
            "autoTerminateGame": true
        },
        "logFolder": "dlss-enabler"
    },
    "metadata": {
        "homepage": "https://github.com/vuenxx/extra_goldteam34",
        "tags": [
            "dlss",
            "frame-generation",
            "upscaler"
        ],
        "notes": "DLSS Enabler evrensel moduleWizardEngine entegrasyonu tamamlandı."
    },
    "aliases": [
        "dlss-enabler"
    ]
}
