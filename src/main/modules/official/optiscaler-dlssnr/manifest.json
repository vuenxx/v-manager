{
    "id": "optiscaler-dlssnr",
    "name": "OptiScaler + DLSS5",
    "description": "OptiScaler'in DLSS5 Neural Rendering eklentili surumu. Upscaler ciktisi uzerine NVIDIA'nin sinirsel render modelini calistirarak detay uretir. nvngx_dlssnr.dll dosyasini kullanici saglamalidir.",
    "conflicts": [
        { "moduleId": "optiscaler", "severity": "block" },
        { "moduleId": "optibuilder", "severity": "block" }
    ],
    "author": "Dagherbou",
    "version": "latest",
    "source": {
        "type": "github",
        "repo": "Dagherbou/OptiScaler_DLSSNR",
        "release": "latest",
        "asset": [
            "*.zip",
            "*.7z"
        ],
        "maxReleases": 10,
        "legacyFolders": [
            "OptiScaler_DLSSNR"
        ]
    },
    "install": {
        "destination": "game_exe",
        "extractRoot": "auto",
        "cleanStaleVersionFiles": true,
        "refreshGameOnComplete": true,
        "files": {
            "exclude": [
                "setup_linux.sh",
                "setup_windows.bat",
                "!! EXTRACT ALL FILES TO GAME FOLDER !!"
            ]
        },
        "proxyDetection": {
            "sourceFile": "OptiScaler.dll",
            "candidates": [
                "dxgi.dll",
                "winmm.dll",
                "d3d12.dll",
                "dbghelp.dll",
                "version.dll",
                "wininet.dll",
                "winhttp.dll"
            ],
            "descriptionMatch": "optiscaler",
            "defaultTarget": "dxgi.dll"
        },
        "verifyAntiVirusDelayMs": 1500
    },

    "backup": {
        "enabled": true,
        "files": [
            "dxgi.dll",
            "winmm.dll",
            "d3d12.dll",
            "version.dll",
            "OptiScaler.ini"
        ],
        "rollbackOnFailure": true
    },
    "config": [
        {
            "file": "OptiScaler.ini",
            "format": "ini",
            "search": [
                "OptiScaler.ini",
                "optiscaler.ini"
            ],
            "required": false,
            "createIfMissing": false,
            "schema": {
