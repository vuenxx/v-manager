    "addons": [
        {
            "moduleId": "optipatcher",
            "label": "OptiPatcher",
            "labelKey": "opti.patcherLabel",
            "description": "OptiScaler icin ek ASI eklentilerini yukler ve ini dosyasini yapilandirir.",
            "default": false,
            "install": {
                "destination": "plugins",
                "files": {
                    "include": [
                        "*.asi"
                    ]
                },
                "renameTo": "OptiPatcher.asi"
            },
            "configChanges": {
                "Plugins.LoadAsiPlugins": "true"
            },
            "descriptionKey": "opti.patcherHelp"
        },
        {
            "moduleId": "fsr4",
            "label": "FSR4 INT8",
            "labelKey": "opti.fsr4Label",
            "description": "FSR4 upscaling dosyalarini yukleyerek oyunda FSR 4 destegi saglar.",
            "default": false,
            "install": {
                "destination": "game_exe",
                "files": {
                    "include": [
                        "*.dll"
                    ]
                }
            },
            "descriptionKey": "opti.fsr4Help"
        }
    ],
    "detect": {
        "priority": 60,
        "exclusiveGroup": "optiscaler-family",
        "depthStrategy": "shallowest",
        "match": {
            "proxyDll": {
                "candidates": [
                    "dxgi.dll",
                    "winmm.dll",
                    "d3d12.dll",
                    "dbghelp.dll",
                    "version.dll",
                    "wininet.dll",
                    "winhttp.dll",
                    "optiscaler.dll"
                ],
                "descriptionMatch": "optiscaler"
            },
            "requireSiblingFile": "nvngx.dll_dlssnr.dll"
        }
    },
    "state": {
        "flag": "hasDlssNr",
        "versionField": "dlssNrVersion",
        "pathField": "dlssNrPath",
        "injectionField": "dlssNrInjection",
        "upscalerField": "dlssnr"
    },
    "uninstall": {
        "files": [
            { "file": "OptiScaler.ini", "unlessAnyState": [ { "flag": "hasOptiscaler", "value": true }, { "flag": "hasOptiBuilder", "value": true } ] },
            "OptiScaler.log",
            "OptiMX.log",
            "nvngx.dll_dlssnr.dll",
            "OptiScaler",
            "D3D12_OptiScaler",
            "dlssnr-capture",
            "READ ME - DLSS Neural Rendering.txt",
            "!! EXTRACT ALL FILES TO GAME FOLDER !!",
            "setup_windows.bat",
            "setup_linux.sh",
            { "file": "fakenvapi.dll", "unlessAnyState": [ { "flag": "hasOptiscaler", "value": true }, { "flag": "hasOptiBuilder", "value": true } ] },
            { "file": "fakenvapi.ini", "unlessAnyState": [ { "flag": "hasOptiscaler", "value": true }, { "flag": "hasOptiBuilder", "value": true } ] },
            { "file": "nvapi64-proxy.dll", "unlessAnyState": [ { "flag": "hasOptiscaler", "value": true }, { "flag": "hasOptiBuilder", "value": true } ] }
        ],
        "verifiedDlls": [
            {
                "candidates": [
                    "dxgi.dll",
                    "winmm.dll",
                    "d3d12.dll",
                    "dbghelp.dll",
                    "version.dll",
                    "wininet.dll",
                    "winhttp.dll"
                ],
                "descriptionMatch": "optiscaler"
            }
        ],
        "restoreBackup": false,
        "resetState": true
    },
    "permissions": [
        "internet",
        "game_files"
    ],
    "metadata": {
        "homepage": "https://github.com/Dagherbou/OptiScaler_DLSSNR",
        "tags": [
            "optiscaler",
            "dlss",
            "neural-rendering",
            "dlss5",
            "upscaler"
        ],
        "notes": "Neural Rendering pass'inin calismasi icin oyun klasorune nvngx_dlssnr.dll gerekir. Bu dosya NVIDIA surucu paketinden gelir; telifli oldugu icin ne bu pakette ne de V-Manager tarafindan dagitilir, kullanici kendi surucusunden kopyalamalidir. Model RTX 50 serisi gerektirir (eski mimariler icin modlu DLL). DLL olmadan da OptiScaler kismi normal calisir, sadece [DlssNr] pass'i devre disi kalir."
    }
}
